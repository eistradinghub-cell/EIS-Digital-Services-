/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

/dashboard
  Cache-Control: no-store, no-cache, must-revalidate

/dashboard.html
  Cache-Control: no-store, no-cache, must-revalidate

/css/*
  Cache-Control: no-cache, must-revalidate

/js/*
  Cache-Control: no-cache, must-revalidate
